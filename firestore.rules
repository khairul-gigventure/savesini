rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity Validation Helpers
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt'])
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() <= 150
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidLink(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'url', 'platform', 'title', 'dateAdded'])
        && data.keys().hasOnly([
          'id', 'userId', 'url', 'platform', 'title', 'notes', 'tags',
          'author', 'authorHandle', 'authorAvatar', 'verified', 'badge',
          'dateAdded', 'displayTimeAgo', 'collectionId', 'originalText',
          'stats', 'assetFormat', 'extractedInsight', 'readTime'
        ])
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.id)
        && data.url is string && data.url.size() > 0 && data.url.size() <= 1024
        && data.platform in ['x', 'threads', 'linkedin', 'facebook', 'web']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 3000))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 30))
        && (!('author' in data) || (data.author is string && data.author.size() <= 150))
        && (!('authorHandle' in data) || (data.authorHandle is string && data.authorHandle.size() <= 100))
        && (!('originalText' in data) || (data.originalText is string && data.originalText.size() <= 3000))
        && (!('collectionId' in data) || data.collectionId == null || (data.collectionId is string && isValidId(data.collectionId)))
        && (!('assetFormat' in data) || data.assetFormat == null || data.assetFormat in ['breakdown', 'framework', 'template'])
        && data.dateAdded is string && data.dateAdded.size() <= 50;
    }

    function isValidCollection(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title'])
        && data.keys().hasOnly([
          'id', 'userId', 'title', 'subtitle', 'tags', 'color',
          'coachSynthesis', 'linkIds', 'avatarPreviews', 'readinessScore',
          'updatedAt', 'activePillar'
        ])
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.id)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 500))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 30))
        && (!('color' in data) || data.color in ['teal', 'blue', 'slate'])
        && (!('coachSynthesis' in data) || (data.coachSynthesis is string && data.coachSynthesis.size() <= 2000))
        && (!('linkIds' in data) || (data.linkIds is list && data.linkIds.size() <= 200))
        && (!('readinessScore' in data) || (data.readinessScore is number && data.readinessScore >= 0 && data.readinessScore <= 100))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId) && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);

      // User Links Subcollection
      match /links/{linkId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(linkId)
          && isValidLink(incoming(), userId)
          && incoming().id == linkId;
        allow update: if isOwner(userId)
          && isValidId(linkId)
          && isValidLink(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(linkId);
      }

      // User Collections Subcollection
      match /collections/{collectionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(collectionId)
          && isValidCollection(incoming(), userId)
          && incoming().id == collectionId;
        allow update: if isOwner(userId)
          && isValidId(collectionId)
          && isValidCollection(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(collectionId);
      }
    }
  }
}
