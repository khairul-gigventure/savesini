{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile metadata and preferences",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the user"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar URL"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["uid", "email"]
    },
    "SocialLink": {
      "title": "Social Link",
      "description": "Curated bookmark from social media or web",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique link identifier"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Owner user ID"
        },
        "url": {
          "type": "string",
          "maxLength": 1024,
          "description": "Original resource URL"
        },
        "platform": {
          "type": "string",
          "enum": ["x", "threads", "linkedin", "facebook", "web"],
          "description": "Social platform type"
        },
        "title": {
          "type": "string",
          "maxLength": 300,
          "description": "Title of the post or article"
        },
        "notes": {
          "type": "string",
          "maxLength": 3000,
          "description": "Personal synthesis and takeaways"
        },
        "tags": {
          "type": "array",
          "description": "List of tags"
        },
        "author": {
          "type": "string",
          "maxLength": 150,
          "description": "Author display name"
        },
        "authorHandle": {
          "type": "string",
          "maxLength": 100,
          "description": "Author handle or slug"
        },
        "originalText": {
          "type": "string",
          "maxLength": 3000,
          "description": "Preserved quote or excerpt"
        },
        "collectionId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional assigned collection ID"
        },
        "assetFormat": {
          "type": "string",
          "enum": ["breakdown", "framework", "template"],
          "description": "Format category"
        },
        "dateAdded": {
          "type": "string",
          "description": "ISO timestamp when added"
        }
      },
      "required": ["id", "userId", "url", "platform", "title", "dateAdded"]
    },
    "CoachingCollection": {
      "title": "Coaching Collection",
      "description": "A thematic knowledge collection",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Collection ID"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Owner user ID"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Collection title"
        },
        "subtitle": {
          "type": "string",
          "maxLength": 500,
          "description": "Collection description or subtitle"
        },
        "tags": {
          "type": "array",
          "description": "Tags associated with collection"
        },
        "color": {
          "type": "string",
          "enum": ["teal", "blue", "slate"],
          "description": "Theme color indicator"
        },
        "coachSynthesis": {
          "type": "string",
          "maxLength": 2000,
          "description": "Strategic notes for the folder"
        },
        "linkIds": {
          "type": "array",
          "description": "List of link IDs inside collection"
        },
        "readinessScore": {
          "type": "number",
          "description": "Readiness indicator percentage"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated relative time or timestamp"
        }
      },
      "required": ["id", "userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User profile document"
    },
    "/users/{userId}/links/{linkId}": {
      "schema": {
        "$ref": "#/entities/SocialLink"
      },
      "description": "User personal saved links"
    },
    "/users/{userId}/collections/{collectionId}": {
      "schema": {
        "$ref": "#/entities/CoachingCollection"
      },
      "description": "User personal coaching collections"
    }
  }
}
